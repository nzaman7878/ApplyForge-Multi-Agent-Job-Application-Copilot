# ==========================================
# ApplyForge Server Environment Variables
# ==========================================

# --- Server Configuration ---
# The port the Express server will listen on
PORT=5000

# The environment mode (development, production, test)
NODE_ENV=development

# --- Database Configuration (Phase 9+) ---
# Connection string for MongoDB
# MONGODB_URI=mongodb://localhost:27017/applyforge

# --- Auth Secrets (Epic B) ---
# Secret key used for signing JWT access tokens
# JWT_SECRET=your_super_secret_jwt_key
# Duration before access token expires
# JWT_EXPIRES_IN=7d
# Secret key used for signing JWT refresh tokens
# JWT_REFRESH_SECRET=your_super_secret_refresh_key

# --- AI Configuration (Epic F) ---
# API key for Anthropic (Claude) via LangChain
# ANTHROPIC_API_KEY=your_anthropic_api_key
# The specific Claude model to use
# LLM_MODEL=claude-3-5-sonnet-20240620
# Temperature (0.0 to 1.0) controlling randomness of output
# LLM_TEMPERATURE=0.7
